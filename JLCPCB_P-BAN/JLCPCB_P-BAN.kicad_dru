(version 1)

(rule "NPTH minimum hole size"
  (condition "A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_size (min 0.5mm)))

(rule "Pad hole to hole"
  (condition "A.Type == 'Pad' || B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))

(rule "TH pad annular ring (hole < 0.9mm)"
  (condition "A.Pad_Type == 'Through-hole' && A.Hole_Size_X < 0.9mm && A.Hole_Size_Y < 0.9mm")
  (constraint annular_width (min 0.18mm)))

(rule "TH pad annular ring (hole >= 0.9mm)"
  (condition "A.Pad_Type == 'Through-hole' && (A.Hole_Size_X >= 0.9mm || A.Hole_Size_Y >= 0.9mm)")
  (constraint annular_width (min 0.2mm)))

(rule "Zone to pad/via"
  (condition "A.Type == 'Zone' && (B.Type == 'Pad' || B.Type == 'Via')")
  (constraint clearance (min 0.5mm)))

(rule "Inner layer track to hole"
  (layer inner)
  (condition "A.Type == 'Track'")
  (constraint hole_clearance (min 0.3mm)))

(rule "Inner layer zone to hole"
  (layer inner)
  (condition "A.Type == 'Zone'")
  (constraint hole_clearance (min 0.5mm)))
(rule "Inner layer NPTH to copper"
  (layer inner)
  (condition "A.Pad_Type == 'NPTH, mechanical' || B.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_clearance (min 0.5mm)))
