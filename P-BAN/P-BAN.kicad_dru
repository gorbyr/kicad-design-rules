(version 1)
(rule "TH pad annular ring"
  (condition "A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.15mm)))
(rule "Large TH pad annular ring"
  (condition "A.Pad_Type == 'Through-hole' && (A.Hole_Size_X >= 0.9mm || A.Hole_Size_Y >= 0.9mm)")
  (constraint annular_width (min 0.2mm)))
